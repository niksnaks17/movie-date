<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>A Tiny Question from 🛸 </title>
<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: "Segoe UI", sans-serif;
}

body {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: linear-gradient(135deg, #ff4d6d, #ff8fab, #ffffff, #8b5cf6, #ff4d6d);
  overflow: hidden;
  position: relative;
  padding: 20px;
}

body::before,
body::after {
  content: "";
  position: absolute;
  inset: -20%;
  background: radial-gradient(circle at 20% 20%, rgba(255,255,255,0.35), transparent 20%),
              radial-gradient(circle at 80% 20%, rgba(255,255,255,0.25), transparent 25%),
              radial-gradient(circle at 50% 80%, rgba(255,255,255,0.2), transparent 20%);
  animation: drift 8s ease-in-out infinite alternate;
  pointer-events: none;
}

body::after {
  animation-duration: 10s;
  transform: scale(1.1);
}

.card {
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(14px);
  padding: 42px;
  border-radius: 24px;
  text-align: center;
  width: min(92vw, 520px);
  box-shadow: 0 20px 45px rgba(0, 0, 0, 0.18);
  z-index: 1;
}

h1 {
  font-size: 2rem;
  margin-bottom: 12px;
  color: #8a0058;
}

p {
  color: #555;
  margin-bottom: 28px;
  line-height: 1.7;
}

.buttons {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

button {
  border: none;
  cursor: pointer;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
  border-radius: 999px;
  font-size: 18px;
  font-weight: 700;
  padding: 14px 28px;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
}

button:hover {
  transform: translateY(-2px) scale(1.03);
}

#yes {
  background: linear-gradient(135deg, #ff4d6d, #b55690);
  color: white;
}

#no {
  background: #f5f5f5;
  color: #444;
}

#message {
  display: none;
}

.heart {
  font-size: 60px;
  animation: float 2s ease-in-out infinite;
  margin-bottom: 10px;
}

@keyframes float {
  50% { transform: translateY(-8px); }
}

@keyframes drift {
  from { transform: translate(-3%, -2%) rotate(0deg); }
  to { transform: translate(3%, 2%) rotate(4deg); }
}
</style>
</head>
<body>
  <div class="card" id="questionCard">
    <h1>Hello, Hello, Hello. 👽🖤</h1>
    <p>Would you like to have a Discord movie date with me tonight?</p>

    <div class="buttons">
      <button id="yes">Yes 💖</button>
      <button id="no">No 🙈</button>
    </div>
  </div>

  <div class="card" id="message">
    <div class="heart">🩷🧡🤍💖❤️</div>
    <h1>It’s a date!</h1>
    <p>
      Yay!! 🥹<br><br>
      I’ll bring the movie.<br>
      You bring yourself.<br>
      I would gladly order the snacks/dinner via Grab 🍿✨ <br>
      Or you can order and I will just do our old love language: Fund Transfer!🥹
    </p>
  </div>

  <script>
    const yes = document.getElementById("yes");
    const no = document.getElementById("no");
    const question = document.getElementById("questionCard");
    const message = document.getElementById("message");

    let scale = 1;
    let attempts = 0;

    no.addEventListener("click", () => {
      attempts += 1;
      scale += 0.16;
      yes.style.transform = `scale(${scale})`;

      const messages = [
        "Are you sure? 🥺",
        "Really sure? 😭",
        "Think again 👉👈",
        "Pretty please? 💜",
        "I’ll let you pick the movie 🍿",
        "You still said no? 😔",
        "Last chance... 👀",
        "Okay, now you’re just being dramatic 😌"
      ];

      no.textContent = messages[Math.min(attempts - 1, messages.length - 1)];

      if (attempts >= 6) {
        yes.textContent = "Yes, please 💖";
      }
    });

    yes.addEventListener("click", () => {
      question.style.display = "none";
      message.style.display = "block";
      document.body.style.background = "linear-gradient(135deg, #ff4d6d, #ff8fab, #ffffff, #8b5cf6, #ff4d6d)";
      window.location.href = "mailto:franconikka1017@gmail.com?subject=Movie%20Date%20Response&body=Someone%20has%20responded%20yes";
    });
  </script>
</body>
</html>
